<UserControl x:Class="PrimalEditor.Editors.GeometryEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ed="clr-namespace:PrimalEditor.Editors"
             xmlns:primal="clr-namespace:PrimalEditor"
             xmlns:utl="clr-namespace:PrimalEditor.Utilities"
             xmlns:content="clr-namespace:PrimalEditor.Content"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=ed:GeometryEditor}"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <content:ImageToRectConverter x:Key="imageToRectConverter"/>
        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource LightTextBlockStyle}"/>
    </UserControl.Resources>
    <UserControl.DataContext>
        <ed:GeometryEditor/>
    </UserControl.DataContext>
    <DockPanel Background="{StaticResource Editor.Window.GrayBrush2}">
        <Border Background="{StaticResource Editor.Window.GrayBrush3}" Height="32" DockPanel.Dock="Top"
                VerticalAlignment="Top" Margin="0,0,0,1">
            <Border.Effect>
                <DropShadowEffect Opacity="0.3" BlurRadius="10" ShadowDepth="0"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" Margin="5,2">
                <TextBlock Text="LOD: " Margin="0,0,5,0"/>
                <Slider Value="{Binding LODIndex}" Minimum="0" Maximum="{Binding MaxLODIndex}"
                        TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                        Width="128" VerticalAlignment="Center" Margin="0" x:Name="lodSlider">
                    <Slider.Style>
                        <Style TargetType="{x:Type Slider}" BasedOn="{StaticResource HorizontalSliderStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MaxLODIndex}" Value="0">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding AutoLOD}" Value="true">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Slider.Style>
                </Slider>

                <TextBlock Text="Auto LOD" Margin="10,0,5,0"/>
                <CheckBox IsChecked="{Binding AutoLOD}" VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" Margin="10,0,5,0">
                    <TextBlock Text="Env. Map:" Margin="0,0,5,0"/>
                    <Grid>
                        <ComboBox ItemsSource="{Binding Source={x:Static content:AssetRegistry.Textures}}" Margin="2,0,0,0" Focusable="False" Padding="0"
                                  FocusVisualStyle="{x:Null}" SelectionChanged="OnAmbientLight_ComboBox_SelectionChanged" Width="48" Cursor="Hand"
                                  IsReadOnly="True" IsEditable="True">
                            <ComboBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" Width="380"/>
                                </ItemsPanelTemplate>
                            </ComboBox.ItemsPanel>
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type content:AssetInfo}">
                                    <Border MaxHeight="{StaticResource AssetIconWidth}" ToolTip="{Binding FileName}">
                                        <Border.CacheMode>
                                            <BitmapCache EnableClearType="True" RenderAtScale="1"/>
                                        </Border.CacheMode>
                                        <Image Source="{Binding Icon}" Width="{StaticResource AssetIconWidth}" Height="{StaticResource AssetIconWidth}"
                                               VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Image.Clip>
                                                <RectangleGeometry Rect="{Binding Child, RelativeSource={RelativeSource AncestorType={x:Type Border}}, Converter={StaticResource imageToRectConverter}}"
                                                                   RadiusX="5" RadiusY="5"/>
                                            </Image.Clip>
                                        </Image>
                                    </Border>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Border MaxHeight="{StaticResource AssetIconWidth}" ToolTip="{Binding AmbientLight.EnvMap.FileName}"
                                IsHitTestVisible="False" VerticalAlignment="Stretch">
                            <Image Source="{Binding AmbientLight.EnvMap.Icon}" HorizontalAlignment="Left">
                                <Image.Clip>
                                    <RectangleGeometry Rect="{Binding Child, RelativeSource={RelativeSource AncestorType={x:Type Border}}, Converter={StaticResource imageToRectConverter}}"
                                           RadiusX="3" RadiusY="3"/>
                                </Image.Clip>
                            </Image>
                        </Border>
                    </Grid>
                </StackPanel>

            </StackPanel>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition MinWidth="250" MaxWidth="400"/>
                <ColumnDefinition MinWidth="250"/>
                <ColumnDefinition MinWidth="250"/>
            </Grid.ColumnDefinitions>

            <ed:GeometryDetailsView Tag="{Binding ElementName=geometryView}" Margin="0,0,5,0"/>
            <GridSplitter HorizontalAlignment="Right" Width="5" VerticalAlignment="Stretch" Background="{StaticResource Editor.Window.GrayBrush1}"/>

            <ed:GeometryView DataContext="{Binding MeshRenderer}" Grid.Column="1" x:Name="geometryView"/>
            <StackPanel Grid.Column="1" Margin="5" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding MeshRenderer.CameraPosition.X, StringFormat=G5}" Foreground="{StaticResource Editor.RedBrush}"/>
                    <TextBlock Text="{Binding MeshRenderer.CameraPosition.Y, StringFormat=G5}" Foreground="{StaticResource Editor.GreenBrush}" Margin="10,0" />
                    <TextBlock Text="{Binding MeshRenderer.CameraPosition.Z, StringFormat=G5}" Foreground="{StaticResource Editor.BlueBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding MeshRenderer.VertexCount, StringFormat=V: {0}}" Foreground="{StaticResource Editor.OrangeBrush}"/>
                    <TextBlock Text="{Binding MeshRenderer.IndexCount, StringFormat=I: {0}}" Foreground="{StaticResource Editor.OrangeBrush}" Margin="10,0"/>
                </StackPanel>
            </StackPanel>

            <GridSplitter Width="5" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Stretch" Background="{StaticResource Editor.Window.GrayBrush1}"/>
            <utl:RenderSurfaceView x:Name="sv" Grid.Column="2" KeyDown="OnRenderSurfaceView_KeyDown"/>
        </Grid>
    </DockPanel>
</UserControl>
