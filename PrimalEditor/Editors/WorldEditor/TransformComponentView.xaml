<UserControl x:Class="PrimalEditor.Editors.TransformComponentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PrimalEditor.Editors"
             xmlns:vm ="clr-namespace:PrimalEditor.Components"
             xmlns:ctrl ="clr-namespace:PrimalEditor.Utilities.Controls"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:MSTransform}"
             d:DesignHeight="450" d:DesignWidth="400">
    <UserControl.Resources>
        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource LightTextBlockStyle}"/>
    </UserControl.Resources>
    <ctrl:ComponentView Header="Transform">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="78"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <TextBlock Text="Position" Grid.Column="0" Grid.Row="0"/>
            <ctrl:VectorBox X="{Binding PosX, TargetNullValue=''}" Y="{Binding PosY, TargetNullValue=''}" Z="{Binding PosZ, TargetNullValue=''}"
                           Grid.Column="2" Grid.Row="0" PreviewMouseLeftButtonUp="On_VectorBox_PreviewMouse_LBU"/>

            <TextBlock Text="Local Offset" Grid.Column="0" Grid.Row="1"/>
            <!-- NOTE: setting context menu to null to disables copy/paste -->
            <ctrl:VectorBox X="{Binding LocalPosX}" Y="{Binding LocalPosY}" Z="{Binding LocalPosZ}" Grid.Column="2" Grid.Row="1"
                           ValueChanged="OnLocalPosition_VectorBox_ValueChanged" ContextMenu="{x:Null}"/>
            
            <TextBlock Text="Rotation" Grid.Column="0" Grid.Row="2"/>
            <ctrl:VectorBox X="{Binding RotX, TargetNullValue=''}" Y="{Binding RotY, TargetNullValue=''}" Z="{Binding RotZ, TargetNullValue=''}"
                           Grid.Column="2" Grid.Row="2" Minimum="0" Maximum="360" WrapAround="True"
                           PreviewMouseLeftButtonUp="On_VectorBox_PreviewMouse_LBU"/>

            <TextBlock Grid.Column="0" Grid.Row="3">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource LightTextBlockStyle}">
                        <Setter Property="Text" Value="Local Offset"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLocalRotation}" Value="False">
                                <Setter Property="Text" Value="World Offset"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <!-- NOTE: setting context menu to null to disables copy/paste -->
            <ctrl:VectorBox X="{Binding RotOffsetX}" Y="{Binding RotOffsetY}" Z="{Binding RotOffsetZ}" Grid.Column="2" Grid.Row="3"
                           Minimum="0" Maximum="360" WrapAround="True" ValueChanged="OnLocalRotation_VectorBox_ValueChanged" ContextMenu="{x:Null}"/>
            <ToggleButton Content="O" IsChecked="{Binding IsLocalRotation}" Width="20" Margin="5,0" Grid.Column="1" Grid.Row="3"/>

            <TextBlock Text="Scale" Grid.Column="0" Grid.Row="4"/>
            <ctrl:VectorBox X="{Binding ScaleX, TargetNullValue=''}" Y="{Binding ScaleY, TargetNullValue=''}" Z="{Binding ScaleZ, TargetNullValue=''}"
                           Grid.Column="2" Grid.Row="4" PreviewMouseLeftButtonUp="On_VectorBox_PreviewMouse_LBU"
                           ValueChanging="OnScale_VectorBox_ValueChanging"/>
            <ToggleButton Content="O" IsChecked="{Binding IsUniformScale}" Width="20" Margin="5,0" Grid.Column="1" Grid.Row="4"/>
        </Grid>
    </ctrl:ComponentView>
</UserControl>
