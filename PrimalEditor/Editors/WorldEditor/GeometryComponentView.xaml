<UserControl x:Class="PrimalEditor.Editors.GeometryComponentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PrimalEditor.Editors"
             xmlns:vm="clr-namespace:PrimalEditor.Components"
             xmlns:ctrl="clr-namespace:PrimalEditor.Utilities.Controls"
             xmlns:primal="clr-namespace:PrimalEditor"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type={x:Type vm:MSGeometry}}"
             d:DesignHeight="450" d:DesignWidth="400">
    <UserControl.Resources>
        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource LightTextBlockStyle}"/>

        <DataTemplate DataType="{x:Type vm:MeshWithMaterial}">
            <Border Margin="0,1,0,0" MinHeight="96" CornerRadius="5">
                <Border.Resources>
                    <Style TargetType="{x:Type TextBlock}" x:Key="{x:Type TextBlock}" BasedOn="{StaticResource LightTextBlockStyle}"/>
                </Border.Resources>
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="Background" Value="{StaticResource Editor.Window.GrayBrush3}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource Editor.Window.GrayBrush2}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <Border Background="{StaticResource Editor.Window.GrayBrush1}" Margin="1" CornerRadius="5" DockPanel.Dock="Top">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.Meshes.Count, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type StackPanel}}}" Value="1">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Orientation="Horizontal" Margin="5,2">
                            <TextBlock Text="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource Mode=TemplatedParent}, StringFormat='{}{0}.'}"
                                       Foreground="{StaticResource Editor.Disabled.FontBrush}"/>
                            <TextBlock Margin="5,0,0,0" Text="{Binding MeshInfo.Name}" FontStyle="Italic" Foreground="{StaticResource Editor.Disabled.FontBrush}"/>
                        </StackPanel>
                    </Border>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="5">
                            <Border CornerRadius="5" BorderThickness="2" BorderBrush="{StaticResource Editor.Window.GrayBrush6}" ClipToBounds="True" Width="64" Height="64">
                                <Border.Background>
                                    <VisualBrush Stretch="Fill">
                                        <VisualBrush.Visual>
                                            <Image Source="{Binding MeshInfo.Icon}"/>
                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </Border.Background>
                            </Border>
                            <StackPanel Margin="10,0">
                                <StackPanel.Resources>
                                    <Style TargetType="{x:Type TextBlock}" x:Key="{x:Type TextBlock}" BasedOn="{StaticResource LightTextBlockStyle}">
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                        <Setter Property="Foreground" Value="Moccasin"/>
                                        <Setter Property="Opacity" Value="0.6"/>
                                    </Style>
                                </StackPanel.Resources>
                                <TextBlock Text="{Binding MeshInfo.VertexCount, StringFormat=V: {0}}"/>
                                <TextBlock Text="{Binding MeshInfo.IndexCount, StringFormat=I: {0}}"/>
                                <TextBlock Text="{Binding MeshInfo.TriangleCount, StringFormat=T: {0}}"/>
                                <TextBlock Text="{Binding Material.Name, StringFormat=M: {0}}"/>
                            </StackPanel>
                        </StackPanel>
                        <Expander Margin="5" Background="{StaticResource Editor.Window.GrayBrush2}">
                            <Expander.Header>
                                <TextBlock Text="Applied Material" Foreground="LavenderBlush" Opacity="0.7"/>
                            </Expander.Header>
                            <Border Height="50" Background="Red">
                                <TextBlock Text="APPLIED MATERIAL VIEW" Foreground="Orange" HorizontalAlignment="Center"/>
                            </Border>
                        </Expander>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type vm:LodWithMaterials}">
            <Grid Background="{StaticResource Editor.Window.GrayBrush3}">
                <Grid.Resources>
                    <Style TargetType="{x:Type TextBlock}" x:Key="{x:Type TextBlock}" BasedOn="{StaticResource LightTextBlockStyle}"/>
                </Grid.Resources>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="{x:Type StackPanel}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.GeometryWithMaterials.LODs.Count, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ContentControl}}}" Value="1">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="Name" Width="73"/>
                        <TextBlock Text="{Binding Name}" d:Text="CharacterModel" Foreground="{StaticResource Editor.GreenBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5,0,0,5">
                        <TextBlock Text="Threshold" Width="73"/>
                        <TextBlock Text="{Binding Threshold}" d:Text="12.34" Foreground="{StaticResource Editor.GreenBrush}"/>
                    </StackPanel>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Meshes}" AlternationCount="{Binding Meshes.Count}" Grid.Row="1">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>
        </DataTemplate>
        
    </UserControl.Resources>

    <ctrl:ComponentView Header="Geometry">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5" Grid.Row="0">
                <TextBlock Text="Name" Width="78"/>
                <TextBlock Text="{Binding GeometryWithMaterials.Name}" d:Text="CharacterModel" Foreground="Moccasin" Opacity="0.6" />
            </StackPanel>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="0,5,0,0" Grid.Row="1">
                <StackPanel Orientation="Horizontal">
                    <Grid>
                        <Border Style="{StaticResource DropBorderStyle}" HorizontalAlignment="Left"
                                Drop="OnGeometry_Border_Drop" MouseLeftButtonDown="OnGeometryBorder_Mouse_LBD">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding GeometryWithMaterials.Icon}" />
                            </Border.Background>
                        </Border>
                        <Border IsHitTestVisible="False" CornerRadius="5" BorderThickness="2">
                            <Border.Background>
                                <ImageBrush ImageSource="/Resources/TextureEditor/Checker64.png"/>
                            </Border.Background>
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GeometryWithMaterials}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border>
                                <Border.Background>
                                    <VisualBrush Viewport="0.1,0.2,0.8,0.6" Visual="{StaticResource MultivalueTextBlock}"/>
                                </Border.Background>
                            </Border>
                        </Border>
                    </Grid>
                    <StackPanel Margin="10,0,0,0" x:Name="meshInfoStackPanel" d:Visibility="Visible">
                        <StackPanel.Style>
                            <Style TargetType="{x:Type StackPanel}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding GeometryWithMaterials.LODs.Count}" Value="1"/>
                                            <Condition Binding="{Binding GeometryWithMaterials.LODs[0].Meshes.Count}" Value="1"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <StackPanel.Resources>
                            <Style TargetType="{x:Type TextBlock}" x:Key="{x:Type TextBlock}" BasedOn="{StaticResource LightTextBlockStyle}">
                                <Setter Property="FontFamily" Value="Consolas"/>
                                <Setter Property="Foreground" Value="Moccasin"/>
                                <Setter Property="Opacity" Value="0.6"/>
                                <Setter Property="DataContext" Value="{Binding GeometryWithMaterials.LODs[0].Meshes[0]}"/>
                            </Style>
                        </StackPanel.Resources>
                        <TextBlock Text="{Binding MeshInfo.VertexCount, StringFormat=V: {0}}" d:Text="V: 80085"/>
                        <TextBlock Text="{Binding MeshInfo.IndexCount, StringFormat=I: {0}}" d:Text="I: 160170"/>
                        <TextBlock Text="{Binding MeshInfo.TriangleCount, StringFormat=T: {0}}" d:Text="T: 4044"/>
                        <TextBlock Text="{Binding Material.Name, StringFormat=M: {0}}" d:Text="M: Material"/>
                    </StackPanel>
                    <Border Margin="10,0" BorderBrush="{StaticResource Editor.OrangeBrush}" BorderThickness="2" CornerRadius="5" d:Visibility="Visible">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Style>
                        </Border.Style>
                        <!-- TODO: APPLY MATERIAL BUTTONS GO HERE -->
                    </Border>
                </StackPanel>

                <Expander Margin="0,5,0,0" Background="{StaticResource Editor.Window.GrayBrush2}" d:IsExpanded="True"
                          Visibility="{Binding Visibility, ElementName=meshInfoStackPanel}">
                    <Expander.Header>
                        <TextBlock Text="Applied Material" Foreground="LavenderBlush" Opacity="0.7"/>
                    </Expander.Header>
                    <Border Height="50" Background="Red">
                        <TextBlock Text="APPLIED MATERIAL VIEW" Foreground="Orange" HorizontalAlignment="Center"/>
                    </Border>
                </Expander>
            </StackPanel>

            <TabControl Background="Transparent" BorderThickness="0" SelectedIndex="0" Grid.Row="2" Margin="-2,10,-2,-2"
                        ItemsSource="{Binding GeometryWithMaterials.LODs}" SelectionChanged="OnTabControl_SelectionChanged"
                        AlternationCount="{Binding GeometryWithMaterials.LODs.Count}">
                <TabControl.Style>
                    <Style TargetType="{x:Type TabControl}">
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding GeometryWithMaterials.LODs.Count}" Value="1"/>
                                    <Condition Binding="{Binding GeometryWithMaterials.LODs[0].Meshes.Count}" Value="1"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding GeometryWithMaterials.LODs.Count}" Value="1">
                                <Setter Property="ItemContainerStyle">
                                    <Setter.Value>
                                        <Style TargetType="{x:Type TabItem}" BasedOn="{StaticResource {x:Type TabItem}}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </Style>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TabControl.Style>
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType={x:Type TabItem}}, StringFormat='{}{0}'}" MinWidth="18"/>
                    </DataTemplate>
                </TabControl.ItemTemplate>
            </TabControl>
        </Grid>
    </ctrl:ComponentView>
</UserControl>
