<UserControl x:Class="PrimalEditor.Editors.GeometryComponentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PrimalEditor.Editors"
             xmlns:vm="clr-namespace:PrimalEditor.Components"
             xmlns:ctrl="clr-namespace:PrimalEditor.Utilities.Controls"
             xmlns:primal="clr-namespace:PrimalEditor"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type={x:Type vm:MSGeometry}}"
             d:DesignHeight="450" d:DesignWidth="400">
    <UserControl.Resources>
        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource LightTextBlockStyle}"/>

        <Style x:Key="arrowHeaderStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <ControlTemplate.Resources>
                            <Storyboard x:Key="arrow1anim1">
                                <DoubleAnimation AutoReverse="True" RepeatBehavior="Forever" Storyboard.TargetProperty="Opacity"
                                                 Storyboard.TargetName="arrow1" From="0.7" To="0.0" Duration="0:0:1" BeginTime="0:0:0.1"/>
                            </Storyboard>
                            <Storyboard x:Key="arrow2anim2">
                                <DoubleAnimation AutoReverse="True" RepeatBehavior="Forever" Storyboard.TargetProperty="Opacity"
                                                 Storyboard.TargetName="arrow2" From="0.7" To="0.0" Duration="0:0:1" BeginTime="0:0:0.3"/>
                            </Storyboard>
                            <Storyboard x:Key="arrow2anim1">
                                <DoubleAnimation AutoReverse="True" RepeatBehavior="Forever" Storyboard.TargetProperty="Opacity"
                                                 Storyboard.TargetName="arrow2" From="0.7" To="0.0" Duration="0:0:1" BeginTime="0:0:0.1"/>
                            </Storyboard>
                            <Storyboard x:Key="arrow1anim2">
                                <DoubleAnimation AutoReverse="True" RepeatBehavior="Forever" Storyboard.TargetProperty="Opacity"
                                                 Storyboard.TargetName="arrow1" From="0.7" To="0.0" Duration="0:0:1" BeginTime="0:0:0.3"/>
                            </Storyboard>
                        </ControlTemplate.Resources>
                        <Border Padding="{TemplateBinding Padding}">
                            <Grid Background="Transparent" SnapsToDevicePixels="False">
                                <ContentPresenter Margin="4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                  SnapsToDevicePixels="True" RecognizesAccessKey="True"/>
                                <StackPanel Margin="0,0,5,0" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            x:Name="arrowStack" Visibility="Collapsed">
                                    <Path x:Name="arrow1" Stroke="#ffa8a4e0" StrokeThickness="2"
                                          SnapsToDevicePixels="False" Data="M 1,1.5 L 5,5 L 9,1.5"/>
                                    <Path x:Name="arrow2" Stroke="#ffa8a4e0" StrokeThickness="2" Margin="0,-1,0,0"
                                          SnapsToDevicePixels="False" Data="M 1,1.5 L 5,5 L 9,1.5"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource arrow1anim1}" x:Name="arrow1anim1_bs"/>
                                    <BeginStoryboard Storyboard="{StaticResource arrow2anim2}" x:Name="arrow2anim2_bs"/>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="arrow1anim1_bs"/>
                                    <StopStoryboard BeginStoryboardName="arrow2anim2_bs"/>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Data" Value="M 1,4.5 L 5,1 L 9,4.5" TargetName="arrow1"/>
                                <Setter Property="Data" Value="M 1,4.5 L 5,1 L 9,4.5" TargetName="arrow2"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource arrow1anim2}" x:Name="arrow1anim2_bs"/>
                                    <BeginStoryboard Storyboard="{StaticResource arrow2anim1}" x:Name="arrow2anim1_bs"/>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="arrow1anim2_bs"/>
                                    <StopStoryboard BeginStoryboardName="arrow2anim1_bs"/>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Visibility" Value="Visible" TargetName="arrowStack"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MaterialExpanderStyle" TargetType="{x:Type Expander}">
            <Setter Property="Foreground" Value="{StaticResource Editor.FontBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Expander}">
                        <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}" CornerRadius="3" SnapsToDevicePixels="True">
                            <DockPanel>
                                <ToggleButton x:Name="HeaderSite" DockPanel.Dock="Top" Margin="1"
                                              Style="{StaticResource arrowHeaderStyle}"
                                              FocusVisualStyle="{x:Null}"
                                              IsChecked="{Binding Path=IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                                              ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
                                              Foreground="{TemplateBinding Foreground}"
                                              Padding="{TemplateBinding Padding}"
                                              FontFamily="{TemplateBinding FontFamily}"
                                              FontSize="{TemplateBinding FontSize}"
                                              FontStyle="{TemplateBinding FontStyle}"
                                              FontStretch="{TemplateBinding FontStretch}"
                                              FontWeight="{TemplateBinding FontWeight}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Cursor="Hand"/>
                                <ContentPresenter x:Name="ExpandSite" DockPanel.Dock="Bottom" Visibility="Collapsed" Focusable="False"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Margin="{TemplateBinding Padding}"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter Property="Visibility" Value="Visible" TargetName="ExpandSite"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type vm:MeshWithMaterial}">
            <Border Margin="0,1,0,0" CornerRadius="5">
                <Border.Resources>
                    <Style TargetType="{x:Type TextBlock}" x:Key="{x:Type TextBlock}" BasedOn="{StaticResource LightTextBlockStyle}"/>
                </Border.Resources>
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="Background" Value="{StaticResource Editor.Window.GrayBrush3}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource Editor.Window.GrayBrush2}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <Border Background="{StaticResource Editor.Window.GrayBrush1}" Margin="1" CornerRadius="5" DockPanel.Dock="Top">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.Meshes.Count, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type StackPanel}}}" Value="1">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Orientation="Horizontal" Margin="5,2">
                            <TextBlock Text="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource Mode=TemplatedParent}, StringFormat='{}{0}.'}"
                                       Foreground="{StaticResource Editor.Disabled.FontBrush}"/>
                            <TextBlock Margin="5,0,0,0" Text="{Binding MeshInfo.Name}" FontStyle="Italic" Foreground="{StaticResource Editor.Disabled.FontBrush}"/>
                        </StackPanel>
                    </Border>
                    <Expander Margin="5" FocusVisualStyle="{x:Null}" Style="{StaticResource MaterialExpanderStyle}"
                              primal:ExpanderStateHelper.StateKey="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource Mode=TemplatedParent}}">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                                <Border CornerRadius="5" BorderThickness="2" BorderBrush="{StaticResource Editor.Window.GrayBrush6}"
                                        ClipToBounds="True" Width="64" Height="64">
                                    <Border.Background>
                                        <VisualBrush Stretch="Fill">
                                            <VisualBrush.Visual>
                                                <Image Source="{Binding MeshInfo.Icon}"/>
                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Border.Background>
                                </Border>
                                <StackPanel Margin="10,0">
                                    <StackPanel.Resources>
                                        <Style TargetType="{x:Type TextBlock}" x:Key="{x:Type TextBlock}" BasedOn="{StaticResource LightTextBlockStyle}">
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                            <Setter Property="Foreground" Value="Moccasin"/>
                                            <Setter Property="Opacity" Value="0.6"/>
                                        </Style>
                                    </StackPanel.Resources>
                                    <TextBlock Text="{Binding MeshInfo.VertexCount, StringFormat=V: {0}}"/>
                                    <TextBlock Text="{Binding MeshInfo.IndexCount, StringFormat=I: {0}}"/>
                                    <TextBlock Text="{Binding MeshInfo.TriangleCount, StringFormat=T: {0}}"/>
                                    <TextBlock Text="{Binding Material.Name, StringFormat=M: {0}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Expander.Header>
                        <local:AppliedMaterialProxyView DataContext="{Binding MaterialProxy}"
                                                        Tag="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource Mode=TemplatedParent}}"/>
                    </Expander>
                </DockPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:LodWithMaterials}">
            <Grid Background="{StaticResource Editor.Window.GrayBrush3}">
                <Grid.Resources>
                    <Style TargetType="{x:Type TextBlock}" x:Key="{x:Type TextBlock}" BasedOn="{StaticResource LightTextBlockStyle}"/>
                </Grid.Resources>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="{x:Type StackPanel}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.GeometryWithMaterials.LODs.Count, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ContentControl}}}" Value="1">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="Name" Width="73"/>
                        <TextBlock Text="{Binding Name}" d:Text="CharacterModel" Foreground="{StaticResource RadioButton.Static.Glyph}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5,0,0,5">
                        <TextBlock Text="Threshold" Width="73"/>
                        <TextBlock Text="{Binding Threshold}" d:Text="12.34" Foreground="{StaticResource RadioButton.Static.Glyph}"/>
                    </StackPanel>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Meshes}" AlternationCount="{Binding Meshes.Count}" Grid.Row="1"/>
            </Grid>
        </DataTemplate>

    </UserControl.Resources>

    <ctrl:ComponentView Header="Geometry">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5" Grid.Row="0">
                <TextBlock Text="Name" Width="78"/>
                <TextBlock Text="{Binding GeometryWithMaterials.Name}" d:Text="CharacterModel" Foreground="Moccasin" Opacity="0.6" />
            </StackPanel>

            <Grid VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="0,5,0,0" Grid.Row="1">
                <Expander d:IsExpanded="True" VerticalAlignment="Top" FocusVisualStyle="{x:Null}"
                          Visibility="{Binding Visibility, ElementName=meshInfoStackPanel}"
                          Style="{StaticResource MaterialExpanderStyle}"
                          primal:ExpanderStateHelper.StateKey="0">
                    <Expander.Header>
                        <Border Height="{Binding ActualHeight, ElementName=iconBorder}"/>
                    </Expander.Header>
                    <local:AppliedMaterialProxyView DataContext="{Binding GeometryWithMaterials.LODs[0].Meshes[0].MaterialProxy}" Tag="0"/>
                </Expander>
                <Grid VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Border Style="{StaticResource DropBorderStyle}" HorizontalAlignment="Left" x:Name="iconBorder"
                                Drop="OnGeometry_Border_Drop" MouseLeftButtonDown="OnGeometryBorder_Mouse_LBD">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding GeometryWithMaterials.Icon}" />
                            </Border.Background>
                        </Border>
                        <Border IsHitTestVisible="False" CornerRadius="5" BorderThickness="2">
                            <Border.Background>
                                <ImageBrush ImageSource="pack://application:,,,/PrimalEditor;component/Resources/TextureEditor/Checker64.png"/>
                            </Border.Background>
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GeometryWithMaterials}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border>
                                <Border.Background>
                                    <VisualBrush Viewport="0.1,0.2,0.8,0.6" Visual="{StaticResource MultivalueTextBlock}"/>
                                </Border.Background>
                            </Border>
                        </Border>
                    </Grid>
                    <StackPanel Margin="10,0,0,0" x:Name="meshInfoStackPanel" d:Visibility="Visible" IsHitTestVisible="False" Grid.Column="1">
                        <StackPanel.Style>
                            <Style TargetType="{x:Type StackPanel}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding GeometryWithMaterials.LODs.Count}" Value="1"/>
                                            <Condition Binding="{Binding GeometryWithMaterials.LODs[0].Meshes.Count}" Value="1"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <StackPanel.Resources>
                            <Style TargetType="{x:Type TextBlock}" x:Key="{x:Type TextBlock}" BasedOn="{StaticResource LightTextBlockStyle}">
                                <Setter Property="FontFamily" Value="Consolas"/>
                                <Setter Property="Foreground" Value="Moccasin"/>
                                <Setter Property="Opacity" Value="0.6"/>
                                <Setter Property="DataContext" Value="{Binding GeometryWithMaterials.LODs[0].Meshes[0]}"/>
                            </Style>
                        </StackPanel.Resources>
                        <TextBlock Text="{Binding MeshInfo.VertexCount, StringFormat=V: {0}}" d:Text="V: 80085"/>
                        <TextBlock Text="{Binding MeshInfo.IndexCount, StringFormat=I: {0}}" d:Text="I: 160170"/>
                        <TextBlock Text="{Binding MeshInfo.TriangleCount, StringFormat=T: {0}}" d:Text="T: 4044"/>
                        <TextBlock Text="{Binding Material.Name, StringFormat='M: {0}'}" d:Text="M: Material"/>
                    </StackPanel>
                    <Border Margin="5,0,0,0" BorderBrush="{StaticResource Editor.OrangeBrush}" Background="{StaticResource Editor.Window.GrayBrush2}"
                            BorderThickness="2" CornerRadius="5" d:Visibility="Collapsed" Grid.Column="1">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEnabled, ElementName=applyButton}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Opacity)" From="1.0" To="0.0"
                                                         Duration="0:0:1" RepeatBehavior="Forever" AutoReverse="True"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                        <StackPanel Margin="10">
                            <Button Content="Apply Changes" Width="96" Height="30" Command="{Binding ApplyChangesCommand}" x:Name="applyButton"/>
                            <Button Content="Reset All" Margin="0,6,0,0" Width="96" Height="30" Command="{Binding ResetCommand}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <TabControl Background="Transparent" BorderThickness="0" SelectedIndex="0" Grid.Row="2" Margin="-2,10,-2,-2"
                        ItemsSource="{Binding GeometryWithMaterials.LODs}" SelectionChanged="OnTabControl_SelectionChanged"
                        AlternationCount="{Binding GeometryWithMaterials.LODs.Count}">
                <TabControl.Style>
                    <Style TargetType="{x:Type TabControl}">
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding GeometryWithMaterials.LODs.Count}" Value="1"/>
                                    <Condition Binding="{Binding GeometryWithMaterials.LODs[0].Meshes.Count}" Value="1"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding GeometryWithMaterials.LODs.Count}" Value="1">
                                <Setter Property="ItemContainerStyle">
                                    <Setter.Value>
                                        <Style TargetType="{x:Type TabItem}" BasedOn="{StaticResource {x:Type TabItem}}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </Style>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TabControl.Style>
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType={x:Type TabItem}}, StringFormat='{}{0}'}" MinWidth="18"/>
                    </DataTemplate>
                </TabControl.ItemTemplate>
            </TabControl>
        </Grid>
    </ctrl:ComponentView>
</UserControl>
