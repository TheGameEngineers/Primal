<UserControl x:Class="PrimalEditor.Editors.SpotlightView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PrimalEditor.Editors"
             xmlns:vm="clr-namespace:PrimalEditor.Components"
             xmlns:ctrl="clr-namespace:PrimalEditor.Utilities.Controls"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:MSSpotlight}"
             d:DesignHeight="450" d:DesignWidth="400" IsTabStop="False">
    <local:PointLightView>
        <local:PointLightView.SpecificLight>
            <Grid Height="32">
                <Grid.Resources>
                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource LightTextBlockStyle}"/>
                </Grid.Resources>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="73"/>
                    <ColumnDefinition Width="29"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Cone Angles" Grid.Column="0" Grid.Row="0"/>
                <ctrl:VectorBox Grid.Column="2" Grid.Row="0" Minimum="0" VectorType="Vector2"
                                X="{Binding Umbra, TargetNullValue=''}"
                                Y="{Binding Penumbra, TargetNullValue=''}" 
                                PreviewMouseLeftButtonUp="On_ScalarBox_PreviewMouse_LBU"/>
            </Grid>
        </local:PointLightView.SpecificLight>
    </local:PointLightView>
</UserControl>
