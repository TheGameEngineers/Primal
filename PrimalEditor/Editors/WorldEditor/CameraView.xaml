<UserControl x:Class="PrimalEditor.Editors.CameraView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PrimalEditor.Editors"
             xmlns:vm="clr-namespace:PrimalEditor.Components"
             xmlns:ctrl="clr-namespace:PrimalEditor.Utilities.Controls"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:MSCamera}"
             d:DesignHeight="450" d:DesignWidth="400">
    <Grid>
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource LightTextBlockStyle}"/>

            <DataTemplate DataType="{x:Type vm:MSPerspectiveCamera}">
                <ctrl:ScalarBox Value="{Binding FieldOfView, TargetNullValue=''}" Minimum="0" Maximum="180"
                                PreviewMouseLeftButtonUp="On_NumberBox_PreviewMouse_LBU"/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:MSOrthographicCamera}">
                <ctrl:ScalarBox Value="{Binding OrthographicSize, TargetNullValue=''}" Minimum="0"
                                PreviewMouseLeftButtonUp="On_NumberBox_PreviewMouse_LBU"/>
            </DataTemplate>
        </Grid.Resources>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="32"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="73"/>
            <ColumnDefinition Width="29"/>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <TextBlock Text="Camera Type"/>
        <TextBlock Grid.Row="0" Grid.Column="2" Foreground="Moccasin" Opacity="0.6">
            <TextBlock.Style>
                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="Text" Value="{Binding CameraType}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CameraType}" Value="{x:Null}">
                            <Setter Property="Text" Value="Mixed Types"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <TextBlock Text="Near/Far Z" Grid.Row="1" />
        <ctrl:VectorBox Grid.Row="1" Grid.Column="2" Minimum="0" VectorType="Vector2"
                        X="{Binding NearZ, TargetNullValue=''}"
                        Y="{Binding FarZ, TargetNullValue=''}"
                        PreviewMouseLeftButtonUp="On_NumberBox_PreviewMouse_LBU"/>

        <TextBlock x:Name="cameraSpecificTextBlock" Grid.Row="2" d:Text="Field of View" d:Visibility="Visible">
            <TextBlock.Style>
                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CameraType}" Value="{x:Static vm:CameraType.Perspective}">
                            <Setter Property="Text" Value="Field of View"/>
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CameraType}" Value="{x:Static vm:CameraType.Orthographic}">
                            <Setter Property="Text" Value="Size"/>
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <ContentPresenter Content="{Binding}" Visibility="{Binding Visibility, ElementName=cameraSpecificTextBlock}" Grid.Row="2" Grid.Column="2"/>
    </Grid>
</UserControl>
