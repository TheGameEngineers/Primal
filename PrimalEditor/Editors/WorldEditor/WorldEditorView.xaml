<UserControl x:Class="PrimalEditor.Editors.WorldEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PrimalEditor.Editors"
             xmlns:utl="clr-namespace:PrimalEditor.Utilities"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:proj="clr-namespace:PrimalEditor.GameProject"
             xmlns:c="clr-namespace:PrimalEditor.Content"
             xmlns:components="clr-namespace:PrimalEditor.Components"
             d:DataContext="{d:DesignInstance Type=proj:Project}"
             mc:Ignorable="d" Focusable="True"
             d:DesignHeight="1080" d:DesignWidth="1920">
    <UserControl.Resources>
        <sys:Boolean x:Key="True">True</sys:Boolean>
        <sys:Boolean x:Key="False">False</sys:Boolean>
        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource LightTextBlockStyle}"/>
    </UserControl.Resources>
    <UserControl.CommandBindings>
        <CommandBinding Command="ApplicationCommands.New" Executed="OnNewProject"/>
        <CommandBinding Command="ApplicationCommands.Open" Executed="OnOpenProject"/>
        <CommandBinding Command="ApplicationCommands.Close" Executed="OnEditorClose"/>
    </UserControl.CommandBindings>
    <UserControl.InputBindings>
        <KeyBinding Command="{Binding UndoCommand}" Key="Z" Modifiers="Ctrl"/>
        <KeyBinding Command="{Binding RedoCommand}" Key="Z" Modifiers="Ctrl+Shift"/>
        <KeyBinding Command="{Binding SaveCommand}" Key="S" Modifiers="Ctrl"/>
        <KeyBinding Command="{Binding DebugStartCommand}" Key="F5"/>
        <KeyBinding Command="{Binding DebugStartWithoutDebuggingCommand}" Key="F5" Modifiers="Ctrl"/>
        <KeyBinding Command="{Binding DebugStopCommand}" Key="F5" Modifiers="Shift"/>
        <KeyBinding Command="{Binding BuildCommand}" CommandParameter="{StaticResource True}" Key="F7"/>
    </UserControl.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Menu Grid.Row="0">
            <MenuItem Header="File">
                <MenuItem Header="New Project..." Command="ApplicationCommands.New"/>
                <MenuItem Header="Open Project..." Command="ApplicationCommands.Open"/>
                <Separator/>
                <MenuItem Header="Save Project" Command="{Binding SaveCommand}"/>
                <Separator/>
                <MenuItem Header="Exit" Command="ApplicationCommands.Close"/>
            </MenuItem>
            <MenuItem Header="Settings"/>
            <MenuItem Header="View"/>
            <MenuItem Header="Create" IsEnabled="False"/>
            <MenuItem Header="Window"/>
        </Menu>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5">
            <Button Content="Undo" Command="{Binding UndoCommand}" Margin="10,0"/>
            <Button Content="Redo" Command="{Binding RedoCommand}"/>
            <Button Content="New Script" Click="OnNewScript_Button_Click" Margin="10,0"
                    IsEnabled="{Binding Path=IsEnabled, ElementName=buildButton}"/>
            <Button x:Name="buildButton" Content="Build"
                    Command="{Binding BuildCommand}" CommandParameter="{StaticResource True}"/>
            <ComboBox x:Name="runConfig" VerticalAlignment="Center" Margin="10,0"
                      Width="72" SelectedIndex="{Binding BuildConfig}">
                <ComboBoxItem Content="Debug"/>
                <ComboBoxItem Content="Release"/>
            </ComboBox>
            <Button Content="Primitive mesh" Click="OnCreatePrimitiveMesh_Button_Click" Margin="10,0"/>
            <TextBlock Text="Light Set:" VerticalAlignment="Center" Margin="10,0,5,0"/>
            <ComboBox ItemsSource="{Binding Source={x:Static components:LightSet.LightSets}}" MinWidth="96" MaxWidth="200"
                      x:Name="lightSetComboBox" SelectionChanged="OnLightSet_ComboBox_SelectionChanged" VerticalAlignment="Center"/>
        </StackPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10*"/>
                <ColumnDefinition Width="1*" MinWidth="300"/>
            </Grid.ColumnDefinitions>
            
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" MinHeight="400"/>
                    <RowDefinition Height="1*" MinHeight="400"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition MinHeight="128"/>
                        <RowDefinition MinHeight="128"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition MinWidth="128"/>
                        <ColumnDefinition MinWidth="128"/>
                    </Grid.ColumnDefinitions>
                    <GridSplitter Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Background="Transparent"
                                  VerticalAlignment="Stretch" HorizontalAlignment="Right" Width="5"/>
                    <GridSplitter Grid.Row="1" Grid.ColumnSpan="2" Grid.Column="0" Background="Transparent"
                                  VerticalAlignment="Top" HorizontalAlignment="Stretch" Height="5"/>
                    <utl:RenderSurfaceView Grid.Row="0" Grid.Column="0" Margin="0,0,5,0" x:Name="sv1" KeyDown="OnProjectLayoutView_KeyDown"/>
                    <utl:RenderSurfaceView Grid.Row="0" Grid.Column="1" Margin="0,0,0,0" x:Name="sv2" KeyDown="OnProjectLayoutView_KeyDown"/>
                    <utl:RenderSurfaceView Grid.Row="1" Grid.Column="0" Margin="0,5,5,0" x:Name="sv3" KeyDown="OnProjectLayoutView_KeyDown"/>
                    <utl:RenderSurfaceView Grid.Row="1" Grid.Column="1" Margin="0,5,0,0" x:Name="sv4" KeyDown="OnProjectLayoutView_KeyDown"/>
                </Grid>
                                   
                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Top" Background="Transparent"/>
                
                <Grid Grid.Row="1" Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" MinWidth="250"/>
                        <ColumnDefinition Width="2*" MinWidth="400"/>
                        <ColumnDefinition Width="4*" MinWidth="800"/>
                    </Grid.ColumnDefinitions>
                    <utl:UndoRedoView DataContext="{Binding UndoRedo}" Grid.Column="0" Background="{StaticResource Editor.Window.GrayBrush2}"/>
                    <GridSplitter Grid.Column="1" Width="5" VerticalAlignment="Stretch" HorizontalAlignment="Left" Background="Transparent"/>
                    <utl:LoggerView Grid.Column="1" Margin="5,0,0,0"/>
                    <GridSplitter Grid.Column="2" Width="5" VerticalAlignment="Stretch" HorizontalAlignment="Left" Background="Transparent"/>
                    <c:ContentBrowserView Grid.Column="2" Margin="5,0,0,0" AllowImport="True" Loaded="OnContentBrowser_Loaded"
                                          IsVisibleChanged="OnContentBrowser_IsVisibleChanged"/>
                </Grid>
            </Grid>
            
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Left" VerticalAlignment="Stretch" Background="Transparent"/>

            <Grid Grid.Column="1" MinWidth="250" Margin="5,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition MinHeight="400" Height="1*"/>
                    <RowDefinition MinHeight="400" Height="2*"/>
                </Grid.RowDefinitions>
                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Top" Background="Transparent"/>
                <local:ProjectLayoutView Background="{StaticResource Editor.Window.GrayBrush3}" KeyDown="OnProjectLayoutView_KeyDown"/>
                <local:GameEntityView Grid.Row="1" Margin="0,5,0,0"/>
            </Grid>

        </Grid>
    </Grid>
</UserControl>
