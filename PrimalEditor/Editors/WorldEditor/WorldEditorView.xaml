<UserControl x:Class="PrimalEditor.Editors.WorldEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:primal="clr-namespace:PrimalEditor"
             xmlns:local="clr-namespace:PrimalEditor.Editors"
             xmlns:utl="clr-namespace:PrimalEditor.Utilities"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:proj="clr-namespace:PrimalEditor.GameProject"
             xmlns:c="clr-namespace:PrimalEditor.Content"
             xmlns:components="clr-namespace:PrimalEditor.Components"
             d:DataContext="{d:DesignInstance Type=proj:Project}"
             mc:Ignorable="d" Focusable="True"
             d:DesignHeight="1080" d:DesignWidth="1920">
    <UserControl.Resources>
        <sys:Boolean x:Key="True">True</sys:Boolean>
        <sys:Boolean x:Key="False">False</sys:Boolean>
        <primal:NegateBoolConverter x:Key="negateBoolConverter"/>
        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource LightTextBlockStyle}"/>

        <Style x:Key="undorRedoPathStyle" TargetType="{x:Type Path}">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="StrokeThickness" Value="1.6"/>
            <Setter Property="Stroke" Value="{StaticResource Editor.FontBrush}"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Stroke" Value="{StaticResource Editor.Disabled.FontBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="verticalSeparatorStyle" TargetType="{x:Type Separator}" BasedOn="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}">
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="Background" Value="{StaticResource Editor.Window.GrayBrush4}"/>
        </Style>

        <Style x:Key="flatButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource PrimalButtonStyle}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="26"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <UserControl.CommandBindings>
        <CommandBinding Command="ApplicationCommands.New" Executed="OnNewProject"/>
        <CommandBinding Command="ApplicationCommands.Open" Executed="OnOpenProject"/>
        <CommandBinding Command="ApplicationCommands.Close" Executed="OnEditorClose"/>
        <CommandBinding Command="{x:Static local:WorldEditorCommands.PlayCommand}" Executed="OnPlayCommand"/>
        <CommandBinding Command="{x:Static local:WorldEditorCommands.RunCommand}" Executed="OnRunCommand"/>
        <CommandBinding Command="{x:Static local:WorldEditorCommands.PauseCommand}" Executed="OnPauseCommand"/>
        <CommandBinding Command="{x:Static local:WorldEditorCommands.ToggleMaximizeCommand}" Executed="OnToggleMaximizeCommand"/>
    </UserControl.CommandBindings>

    <UserControl.InputBindings>
        <KeyBinding Command="{Binding UndoCommand}" Key="Z" Modifiers="Ctrl"/>
        <KeyBinding Command="{Binding RedoCommand}" Key="Z" Modifiers="Ctrl+Shift"/>
        <KeyBinding Command="{Binding SaveCommand}" Key="S" Modifiers="Ctrl"/>
        <KeyBinding Command="{Binding DebugStartCommand}" Key="F5"/>
        <KeyBinding Command="{Binding DebugStartWithoutDebuggingCommand}" Key="F5" Modifiers="Ctrl"/>
        <KeyBinding Command="{Binding DebugStopCommand}" Key="F5" Modifiers="Shift"/>
        <KeyBinding Command="{Binding BuildCommand}" CommandParameter="{StaticResource True}" Key="F7"/>
    </UserControl.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Menu Grid.Row="0">
            <MenuItem Header="File">
                <MenuItem Header="New Project..." Command="ApplicationCommands.New"/>
                <MenuItem Header="Open Project..." Command="ApplicationCommands.Open"/>
                <Separator/>
                <MenuItem Header="Save Project" Command="{Binding SaveCommand}"/>
                <Separator/>
                <MenuItem Header="Exit" Command="ApplicationCommands.Close"/>
            </MenuItem>
            <MenuItem Header="Settings"/>
            <MenuItem Header="View"/>
            <MenuItem Header="Create" IsEnabled="False"/>
            <MenuItem Header="Window"/>
        </Menu>
        <Border Grid.Row="1" Background="{StaticResource Editor.Window.GrayBrush3}">
            <StackPanel Orientation="Horizontal" Margin="0,5" d:Visibility="Visible">
                <StackPanel.Style>
                    <Style TargetType="{x:Type StackPanel}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Button Command="{Binding UndoCommand}" Margin="8,0,5,0" ToolTip="Undo" BorderThickness="0" Background="Transparent">
                    <Path Data="M7,9 L3,13 L7,17 M3,13 H15 C21,13 21,22 15,22 H11"
                          Style="{StaticResource undorRedoPathStyle}"/>
                </Button>
                <Button Command="{Binding RedoCommand}" ToolTip="Redo" BorderThickness="0" Background="Transparent">
                    <Path Data="M9,9 L13,13 L9,17 M13,13 H1 C-5,13 -5,22 1,22 H5"
                          Style="{StaticResource undorRedoPathStyle}"/>
                </Button>
                <Separator Style="{StaticResource verticalSeparatorStyle}"/>
                <Button Click="OnNewScript_Button_Click" IsEnabled="{Binding Path=IsEnabled, ElementName=buildButton}"
                        Style="{StaticResource flatButtonStyle}" ToolTip="New Script" >
                    <Image Source="pack://application:,,,/PrimalEditor;component/Resources/WorldEditor/NewScript.png" 
                           Height="20" Opacity="0.9"/>
                </Button>
                <Button x:Name="buildButton" ToolTip="Build game code DLL (F7)" Margin="5,0"
                        Command="{Binding BuildCommand}" CommandParameter="{StaticResource True}" Style="{StaticResource flatButtonStyle}">
                    <Image Source="pack://application:,,,/PrimalEditor;component/Resources/WorldEditor/BuildDll.png"
                           Height="20" Opacity="0.9"/>
                </Button>
                <ComboBox x:Name="runConfig" VerticalAlignment="Center"
                          Width="72" SelectedIndex="{Binding BuildConfig}">
                    <ComboBoxItem Content="Debug"/>
                    <ComboBoxItem Content="Release"/>
                </ComboBox>
                <ToggleButton Width="26" Height="24" Padding="0,6" Background="Transparent" BorderThickness="0"
                              Click="OnRun_ToggleButton_Click" Focusable="False" ToolTip="Run scripts (Shift+F6)"
                              Margin="5,0" x:Name="runToggleButton">
                    <Path Data="M 0,0.167 Q 0,0 0.141,0.088 L 0.659,0.412 Q 0.8,0.5 0.659,0.588 L 0.141,0.912 Q 0,1 0,0.833 Z"
                          Stretch="Uniform" Margin="2,0,0,0">
                        <Path.Style>
                            <Style TargetType="{x:Type Path}">
                                <Setter Property="Fill" Value="{StaticResource Editor.OrangeBrush}"/>
                                <Setter Property="Opacity" Value="0.7"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}" Value="True">
                                        <Setter Property="Fill" Value="White"/>
                                        <Setter Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </ToggleButton>
                <ToggleButton Width="26" Height="24" Padding="0" Background="Transparent" BorderThickness="0"
                              Click="OnPause_ToggleButton_Click" Focusable="False" ToolTip="Pause (F8)" Margin="0,0,5,0"
                              x:Name="pauseToggleButton" IsEnabled="{Binding IsChecked, ElementName=runToggleButton}" d:IsEnabled="False">
                    <Path Data="M2,0 2,11 M8,0 8,11" StrokeThickness="4">
                        <Path.Style>
                            <Style TargetType="{x:Type Path}">
                                <Setter Property="Stroke" Value="{StaticResource Editor.RedBrush}"/>
                                <Setter Property="Opacity" Value="0.3"/>
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="True">
                                        <Setter Property="Opacity" Value="0.6"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}" Value="True">
                                        <Setter Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </ToggleButton>
                <ToggleButton Width="26" Height="24" Padding="0" Background="Transparent" BorderThickness="0"
                              Click="OnPlay_ToggleButton_Click" Focusable="False" x:Name="playToggleButton"
                              ToolTip="Play in viewport (F6)">
                    <Grid >
                        <Rectangle Width="22" Height="12" RadiusX="5" RadiusY="7">
                            <Rectangle.Style>
                                <Style TargetType="{x:Type Rectangle}">
                                    <Setter Property="Fill" Value="{StaticResource RadioButton.Static.Glyph}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}" Value="True">
                                            <Setter Property="Fill" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>
                        <Path Data="M6,3 6,9 M3,6 9,6 M16,3 16,4 M16,8 16,9 M13,6 14,6 M18,6 19,6"
                              Stroke="{StaticResource Editor.Window.GrayBrush1}" 
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeThickness="2"/>
                    </Grid>
                </ToggleButton>
                <Button ToolTip="Debug Launch (F5)" Style="{StaticResource flatButtonStyle}" Margin="5,0"
                        Command="{Binding DebugStartCommand}">
                    <Image Source="pack://application:,,,/PrimalEditor;component/Resources/WorldEditor/LaunchDebug.png" Height="20"/>
                </Button>
                <Button ToolTip="Launch (Ctrl+F5)" Style="{StaticResource flatButtonStyle}"
                        Command="{Binding DebugStartWithoutDebuggingCommand}">
                    <Image Source="pack://application:,,,/PrimalEditor;component/Resources/WorldEditor/Launch.png" Height="20"/>
                </Button>
                <Separator Style="{StaticResource verticalSeparatorStyle}"/>
                <Button ToolTip="Primitive mesh" Click="OnCreatePrimitiveMesh_Button_Click" Style="{StaticResource flatButtonStyle}">
                    <Image Source="pack://application:,,,/PrimalEditor;component/Resources/WorldEditor/PrimitiveMesh.png" Height="20"/>
                </Button>
                <Separator Style="{StaticResource verticalSeparatorStyle}"/>
                <TextBlock Text="Light Set:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox ItemsSource="{Binding Source={x:Static components:LightSet.LightSets}}" MinWidth="96" MaxWidth="200"
                          x:Name="lightSetComboBox" SelectionChanged="OnLightSet_ComboBox_SelectionChanged" VerticalAlignment="Center"/>
                <Separator Style="{StaticResource verticalSeparatorStyle}"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10*"/>
                <ColumnDefinition Width="1*" MinWidth="300" MaxWidth="600"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" MinHeight="400"/>
                    <RowDefinition Height="1*" MinHeight="400"/>
                </Grid.RowDefinitions>
                <Grid>
                    <!--<Grid.RowDefinitions>
                        <RowDefinition MinHeight="128"/>
                        <RowDefinition MinHeight="128"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition MinWidth="128"/>
                        <ColumnDefinition MinWidth="128"/>
                    </Grid.ColumnDefinitions>
                    <GridSplitter Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Background="Transparent"
                                  VerticalAlignment="Stretch" HorizontalAlignment="Right" Width="5"/>
                    <GridSplitter Grid.Row="1" Grid.ColumnSpan="2" Grid.Column="0" Background="Transparent"
                                  VerticalAlignment="Top" HorizontalAlignment="Stretch" Height="5"/>
                    <utl:RenderSurfaceView Grid.Row="0" Grid.Column="0" Margin="0,0,5,0" x:Name="sv1" KeyDown="OnProjectLayoutView_KeyDown"/>
                    <utl:RenderSurfaceView Grid.Row="0" Grid.Column="1" Margin="0,0,0,0" x:Name="sv2" KeyDown="OnProjectLayoutView_KeyDown"/>
                    <utl:RenderSurfaceView Grid.Row="1" Grid.Column="0" Margin="0,5,5,0" x:Name="sv3" KeyDown="OnProjectLayoutView_KeyDown"/>
                    <utl:RenderSurfaceView Grid.Row="1" Grid.Column="1" Margin="0,5,0,0" x:Name="sv4" KeyDown="OnProjectLayoutView_KeyDown"/>-->
                    <utl:RenderSurfaceView x:Name="sv1" KeyDown="OnProjectLayoutView_KeyDown"/>
                </Grid>

                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Top" Background="Transparent"/>

                <Grid Grid.Row="1" Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" MinWidth="250"/>
                        <ColumnDefinition Width="2*" MinWidth="400"/>
                        <ColumnDefinition Width="4*" MinWidth="800"/>
                    </Grid.ColumnDefinitions>
                    <utl:UndoRedoView DataContext="{Binding UndoRedo}" Grid.Column="0" Background="{StaticResource Editor.Window.GrayBrush2}"/>
                    <GridSplitter Grid.Column="1" Width="5" VerticalAlignment="Stretch" HorizontalAlignment="Left" Background="Transparent"/>
                    <utl:LoggerView Grid.Column="1" Margin="5,0,0,0"/>
                    <GridSplitter Grid.Column="2" Width="5" VerticalAlignment="Stretch" HorizontalAlignment="Left" Background="Transparent"/>
                    <c:ContentBrowserView Grid.Column="2" Margin="5,0,0,0" AllowImport="True" Loaded="OnContentBrowser_Loaded"
                                          IsVisibleChanged="OnContentBrowser_IsVisibleChanged"/>
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Left" VerticalAlignment="Stretch" Background="Transparent"/>

            <Grid Grid.Column="1" MinWidth="250" Margin="5,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition MinHeight="400" Height="1*"/>
                    <RowDefinition MinHeight="400" Height="2*"/>
                </Grid.RowDefinitions>
                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Top" Background="Transparent"/>
                <local:ProjectLayoutView Background="{StaticResource Editor.Window.GrayBrush3}" KeyDown="OnProjectLayoutView_KeyDown"/>
                <local:GameEntityView Grid.Row="1" Margin="0,5,0,0"/>
            </Grid>

        </Grid>
    </Grid>
</UserControl>
