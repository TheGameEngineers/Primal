<Window x:Class="PrimalEditor.Editors.NewLightSetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PrimalEditor.Editors"
        xmlns:vm="clr-namespace:PrimalEditor.Components"
        mc:Ignorable="d" Style="{StaticResource PrimalDialogStyle}"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"       
        Title="New Light Set" Height="250" Width="400"
        MinWidth="400" MinHeight="250" MaxWidth="800" MaxHeight="1200"
        Loaded="OnNewLightSet_Dialog_Loaded">
    <Window.Resources>
        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource LightTextBlockStyle}"/>
    </Window.Resources>
    <Border CornerRadius="3" Background="{StaticResource Editor.Window.GrayBrush3}"
            HorizontalAlignment="Stretch" Margin="10">
        <Border.Effect>
            <DropShadowEffect Opacity="0.6" BlurRadius="15" ShadowDepth="2" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="10,10,10,5">
                <TextBlock Text="Light Set Name:"/>
                <DockPanel Margin="0,10,0,0">
                    <Button Content="Create" Width="64" Margin="5,0,0,0" Click="OnCreate_Button_Click" DockPanel.Dock="Right"/>
                    <TextBox x:Name="lightSetNameTextBox" KeyDown="OnLightSet_TextBox_KeyDown"/>
                </DockPanel>
                <Grid>
                    <TextBlock Text="Please use only alphanumeric characters, underscores, or spaces." Margin="0,5,0,0"
                               x:Name="invalidNameTextBlock" Foreground="{StaticResource Editor.RedBrush}" Visibility="Collapsed"/>
                    <TextBlock Text="A light set with the same name already exists." Foreground="{StaticResource Editor.OrangeBrush}"
                               x:Name="warningTextBlock" Visibility="Hidden" d:Visibility="Visible" Margin="0,5,0,0"/>
                </Grid>
                <TextBlock Text="Existing Light Sets:" Margin="0,5,0,0"/>
            </StackPanel>
            <ListBox x:Name="lightSetsListBox" ItemsSource="{Binding Source={x:Static vm:LightSet.LightSets}}"
                     Grid.Row="1" Margin="10,0" MinHeight="40"/>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                <Button Content="OK" Width="64" Click="OnOk_Button_Click"/>
                <Button Content="Cancel" Width="64" Margin="10,0,0,0" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
