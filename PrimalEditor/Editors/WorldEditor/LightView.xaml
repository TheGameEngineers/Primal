<UserControl x:Class="PrimalEditor.Editors.LightView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PrimalEditor.Editors"
             xmlns:vm="clr-namespace:PrimalEditor.Components"
             xmlns:ctrl="clr-namespace:PrimalEditor.Utilities.Controls"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:MSLight}"
             d:DesignHeight="450" d:DesignWidth="800" IsTabStop="False">
    <Grid>
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource LightTextBlockStyle}"/>
            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource FlatImageButton}">
                <Setter Property="Width" Value="24"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Margin" Value="0,0,5,0"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="73"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <TextBlock Text="Light Set" Width="73" Grid.Column="0" Grid.Row="0"/>
        <ComboBox x:Name="lightSetComboBox" SelectedItem="{Binding LightSetKey, Mode=OneWay}" Grid.Column="2" Grid.Row="0" 
                  VerticalAlignment="Center" HorizontalContentAlignment="Stretch" Margin="0,4"
                  DropDownClosed="OnLightSetKey_ComboBox_DropDownClosed" PreviewMouseWheel="OnLightSetKey_ComboBox_PreviewMouseWheel">
            <ComboBox.Resources>
                <CollectionViewSource Source="{Binding Source={x:Static vm:LightSet.LightSets}}" x:Key="lightSets"/>
            </ComboBox.Resources>
            <ComboBox.ItemsSource>
                <CompositeCollection>
                    <ComboBoxItem Content="New Light Set..." Selected="OnNewLightSet_ComboBoxItem_Selected">
                        <ComboBoxItem.Style>
                            <Style TargetType="{x:Type ComboBoxItem}" BasedOn="{StaticResource ListBoxItemStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ComboBoxItem.Style>
                    </ComboBoxItem>
                    <Separator Background="{StaticResource Editor.Window.GrayBrush4}"/>
                    <CollectionContainer Collection="{Binding Source={StaticResource lightSets}}"/>
                </CompositeCollection>
            </ComboBox.ItemsSource>
        </ComboBox>

        <TextBlock Text="Color" Grid.Column="0" Grid.Row="1"/>
        <Button Grid.Column="1" Grid.Row="1" x:Name="lightColorButton"/>
        <ctrl:VectorBox Grid.Column="2" Grid.Row="1" Minimum="0" Maximum="1"
                        X="{Binding ColorR, TargetNullValue=''}"
                        Y="{Binding ColorG, TargetNullValue=''}"
                        Z="{Binding ColorB, TargetNullValue=''}"
                        ValueChanging="OnColor_VectorBox_ValueChanging"
                        PreviewMouseLeftButtonUp="On_NumberBox_PreviewMouse_LBU"/>

        <TextBlock Text="Intensity" Grid.Column="0" Grid.Row="2"/>
        <ctrl:ScalarBox Value="{Binding Intensity, TargetNullValue=''}" Grid.Column="2" Grid.Row="2" Minimum="0"
                        PreviewMouseLeftButtonUp="On_NumberBox_PreviewMouse_LBU"/>

        <ContentPresenter Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="3"
                          Content="{Binding SpecificLight, RelativeSource={RelativeSource AncestorType={x:Type local:LightView}}}"/>
    </Grid>
</UserControl>
