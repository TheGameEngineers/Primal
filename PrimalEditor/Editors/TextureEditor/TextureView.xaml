<UserControl x:Class="PrimalEditor.Editors.TextureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ed="clr-namespace:PrimalEditor.Editors"
             xmlns:primal="clr-namespace:PrimalEditor"
             xmlns:opt="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             d:DataContext="{d:DesignInstance Type=ed:TextureEditor}"
             d:DesignHeight="450" d:DesignWidth="800" mc:Ignorable="d">
    <Grid>
        <Grid ClipToBounds="True"
              MouseRightButtonDown="OnGrid_Mouse_RBD" MouseRightButtonUp="OnGrid_Mouse_RBU"
              MouseWheel="OnGrid_Mouse_Wheel" PreviewMouseMove="OnGrid_Mouse_Move" x:Name="backgroundGrid">
            <Grid.Background>
                <VisualBrush TileMode="Tile" Viewport="0,0,200,200" ViewportUnits="Absolute" Visual="{StaticResource TiledGridBackground}" opt:Freeze="True"/>
            </Grid.Background>
            <Grid.LayoutTransform>
                <ScaleTransform />
            </Grid.LayoutTransform>

            <Canvas IsHitTestVisible="False">
                <Border x:Name="imageBorder">
                    <Border.Background>
                        <ImageBrush x:Name="textureBackground" TileMode="Tile" Viewport="0,0,64,64" ViewportUnits="Absolute"
                                    ImageSource="/PrimalEditor;component/Resources/TextureEditor/Checker64.png"/>
                    </Border.Background>
                    <Border.Resources>
                        <primal:ReciprocalConverter x:Key="reciprocalConverter" />
                        <ed:ArrayIndexToCubeFaceConverter x:Key="arrayIndexToCubeFaceConverter" />
                        <ed:ChannelSelectEffect x:Key="channelEffect" Channels="{Binding Channels}" Stride="{Binding Stride}"/>
                        <ScaleTransform x:Key="scaleTransform"
                            ScaleX="{Binding Path=ScaleFactor, RelativeSource={RelativeSource AncestorType={x:Type ed:TextureView}}, Converter={StaticResource reciprocalConverter}}"
                            ScaleY="{Binding Path=ScaleFactor, RelativeSource={RelativeSource AncestorType={x:Type ed:TextureView}}, Converter={StaticResource reciprocalConverter}}"/>

                        <Image x:Key="singleImageView" Source="{Binding SelectedSliceBitmap}" Effect="{StaticResource channelEffect}"/>

                        <Style TargetType="{x:Type Path}" x:Key="{x:Type Path}">
                            <Setter Property="Fill" Value="{StaticResource Editor.OrangeBrush}"/>
                            <Setter Property="Stroke" Value="#8f000000" />
                            <Setter Property="StrokeThickness" Value="2"/>
                            <Setter Property="StrokeLineJoin" Value="Round" />
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="-32"/>
                        </Style>

                        <Style TargetType="{x:Type Grid}" x:Key="gridStyle">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ArrayIndex, Converter={StaticResource arrayIndexToCubeFaceConverter}, NotifyOnTargetUpdated=True}" Value="0">
                                    <Setter Property="Grid.Row" Value="1"/>
                                    <Setter Property="Grid.Column" Value="2"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ArrayIndex, Converter={StaticResource arrayIndexToCubeFaceConverter}, NotifyOnTargetUpdated=True}" Value="1">
                                    <Setter Property="Grid.Row" Value="1"/>
                                    <Setter Property="Grid.Column" Value="0"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ArrayIndex, Converter={StaticResource arrayIndexToCubeFaceConverter}, NotifyOnTargetUpdated=True}" Value="2">
                                    <Setter Property="Grid.Row" Value="0"/>
                                    <Setter Property="Grid.Column" Value="1"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ArrayIndex, Converter={StaticResource arrayIndexToCubeFaceConverter}, NotifyOnTargetUpdated=True}" Value="3">
                                    <Setter Property="Grid.Row" Value="2"/>
                                    <Setter Property="Grid.Column" Value="1"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ArrayIndex, Converter={StaticResource arrayIndexToCubeFaceConverter}, NotifyOnTargetUpdated=True}" Value="4">
                                    <Setter Property="Grid.Row" Value="1"/>
                                    <Setter Property="Grid.Column" Value="1"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ArrayIndex, Converter={StaticResource arrayIndexToCubeFaceConverter}, NotifyOnTargetUpdated=True}" Value="5">
                                    <Setter Property="Grid.Row" Value="1"/>
                                    <Setter Property="Grid.Column" Value="3"/>
                                </DataTrigger>
                                <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                    <BeginStoryboard>
                                        <Storyboard AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:1" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Style.Triggers>
                        </Style>

                        <Grid x:Key="cubeMapView">
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <Image Source="{Binding CubeMap.PositiveX}" Grid.Row="1" Grid.Column="2" Effect="{StaticResource channelEffect}"/>
                            <Image Source="{Binding CubeMap.NegativeX}" Grid.Row="1" Grid.Column="0" Effect="{StaticResource channelEffect}"/>
                            <Image Source="{Binding CubeMap.PositiveY}" Grid.Row="0" Grid.Column="1" Effect="{StaticResource channelEffect}"/>
                            <Image Source="{Binding CubeMap.NegativeY}" Grid.Row="2" Grid.Column="1" Effect="{StaticResource channelEffect}"/>
                            <Image Source="{Binding CubeMap.PositiveZ}" Grid.Row="1" Grid.Column="1" Effect="{StaticResource channelEffect}"/>
                            <Image Source="{Binding CubeMap.NegativeZ}" Grid.Row="1" Grid.Column="3" Effect="{StaticResource channelEffect}"/>

                            <Grid Style="{StaticResource gridStyle}" LayoutTransform="{StaticResource scaleTransform}">
                                <Path Data="M0,0 L32,16 0,32 8,16 z" HorizontalAlignment="Left"/>
                                <Path Data="M0,16 L32,0 24,16 32,32 z" HorizontalAlignment="Right"/>
                                <Path Data="M0,32 L16,0 32,32 16,24 z" VerticalAlignment="Bottom"/>
                                <Path Data="M0,0 L16,8 32,0 16,32 z" VerticalAlignment="Top"/>
                            </Grid>
                        </Grid>

                        <DataTemplate DataType="{x:Type ed:TextureEditor}" >
                            <Grid>
                                <ContentPresenter Content="{StaticResource singleImageView}" x:Name="singleImagePresenter"/>
                                <ContentPresenter Content="{StaticResource cubeMapView}" x:Name="cubeMapPresenter" Visibility="Collapsed"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Texture.IsCubeMap}" Value="True"/>
                                        <Condition Binding="{Binding ViewAsCubeMap}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" TargetName="singleImagePresenter" Value="Collapsed"/>
                                    <Setter Property="Visibility" TargetName="cubeMapPresenter" Value="Visible"/>
                                </MultiDataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </Border.Resources>
                    <ContentPresenter x:Name="textureImage" Content="{Binding}" />
                </Border>
            </Canvas>
        </Grid>

        <!-- ZOOM LABEL -->
        <Border x:Name="zoomLabel" Margin="5" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#50000000" CornerRadius="5"
                IsHitTestVisible="False" Opacity="0" d:Opacity="1">
            <TextBlock Text="{Binding Path=ScaleFactor, RelativeSource={RelativeSource AncestorType={x:Type ed:TextureView}}, StringFormat=ZOOM {0:p0}}"
                       d:Text="ZOOM 50%" Margin="10,5" HorizontalAlignment="Left" VerticalAlignment="Top"
                       FontFamily="Bahnschrift condensed" FontSize="32" Foreground="{StaticResource Editor.FontBrush}"/>
        </Border>
        
        <!-- STATE LABEL -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" d:Visibility="Visible"
                Background="#50000000" CornerRadius="5" IsHitTestVisible="False">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="{x:Static ed:AssetEditorState.Done}">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:2"/>
                                        <ObjectAnimationUsingKeyFrames BeginTime="0:0:0" Duration="0:0:2" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:2" Value="{x:Static Visibility.Collapsed}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1"/>
                                        <ObjectAnimationUsingKeyFrames BeginTime="0:0:0" Duration="0:0:0.1" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.1" Value="{x:Static Visibility.Visible}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <TextBlock Margin="10,5" FontFamily="Bahnschrift condensed" FontSize="32" d:Text="LOADING...">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource LightTextBlockStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="{x:Static ed:AssetEditorState.Done}">
                                <Setter Property="Text" Value="DONE."/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="{x:Static ed:AssetEditorState.Importing}">
                                <Setter Property="Text" Value="IMPORTING..."/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="{x:Static ed:AssetEditorState.Processing}">
                                <Setter Property="Text" Value="PROCESSING..."/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="{x:Static ed:AssetEditorState.Loading}">
                                <Setter Property="Text" Value="LOADING..."/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="{x:Static ed:AssetEditorState.Saving}">
                                <Setter Property="Text" Value="SAVING..."/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
                <TextBlock.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation AutoReverse="True" RepeatBehavior="Forever" Storyboard.TargetProperty="Opacity"
                                                 From="1.0" To="0.0" Duration="0:0:1"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </TextBlock.Triggers>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
