<UserControl x:Class="PrimalEditor.Editors.MaterialSurfaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PrimalEditor.Editors"
             xmlns:vm="clr-namespace:PrimalEditor.Components"
             xmlns:ctrl="clr-namespace:PrimalEditor.Utilities.Controls"
             xmlns:content="clr-namespace:PrimalEditor.Content"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:AppliedMaterialProxy}"
             d:DesignHeight="250" d:DesignWidth="400">
    <UserControl.Resources>
        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource LightTextBlockStyle}"/>
        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource FlatImageButton}">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="5,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Base Color" Grid.Column="0" Grid.Row="0"/>
        <Button Grid.Column="1" Grid.Row="0" x:Name="baseColorButton"/>

        <ctrl:VectorBox x:Name="baseColor" Minimum="0" Maximum="1" VectorType="Vector4" Grid.Column="2" Grid.Row="0"
                        ValueChanging="OnVectorBox_ValueChanging" ValueChanged="OnVectorBox_ValueChanged"/>

        <TextBlock Text="Emissive Color" Grid.Column="0" Grid.Row="1"/>
        <Button Grid.Column="1" Grid.Row="1" x:Name="emissiveColorButton"/>

        <ctrl:VectorBox x:Name="emissiveColor" Minimum="0" Maximum="1" Grid.Column="2" Grid.Row="1"
                        ValueChanging="OnVectorBox_ValueChanging" ValueChanged="OnVectorBox_ValueChanged"/>

        <TextBlock Text="Emissive Intensity" Grid.Column="0" Grid.Row="2"/>
        <ctrl:ScalarBox x:Name="emissiveIntensity" ValueChanged="OnScalarBox_ValueChanged"
                        Minimum="0" Maximum="{Binding Source={x:Static content:Material.MaxEmissiveIntensity}}" Grid.Column="2" Grid.Row="2"/>

        <TextBlock Text="Metallic" Grid.Column="0" Grid.Row="3"/>
        <ctrl:ScalarBox x:Name="metallic" ValueChanged="OnScalarBox_ValueChanged"
                        Minimum="0" Maximum="1" Grid.Column="2" Grid.Row="3"/>

        <TextBlock Text="Roughness" Grid.Column="0" Grid.Row="4"/>
        <ctrl:ScalarBox x:Name="roughness" ValueChanged="OnScalarBox_ValueChanged"
                        Minimum="0" Maximum="1" Grid.Column="2" Grid.Row="4"/>
    </Grid>
</UserControl>
