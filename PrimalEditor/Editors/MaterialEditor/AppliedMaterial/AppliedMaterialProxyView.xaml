<UserControl x:Class="PrimalEditor.Editors.AppliedMaterialProxyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PrimalEditor.Editors"
             xmlns:vm="clr-namespace:PrimalEditor.Components"
             xmlns:primal="clr-namespace:PrimalEditor"
             xmlns:content="clr-namespace:PrimalEditor.Content"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:AppliedMaterialProxy}"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <SolidColorBrush x:Key="panelBackground" Color="{StaticResource Editor.Window.GrayColor1}"/>
        <DataTemplate DataType="{x:Type vm:InputProxy}">
            <StackPanel Margin="5,0">
                <Grid>
                    <Border Style="{StaticResource DropBorderStyle}" ToolTip="{Binding Asset.FullPath}"
                            Drop="OnTexture_Border_Drop" MouseLeftButtonDown="OnInputBorder_Mouse_LBD">
                        <Border.Background>
                            <VisualBrush Stretch="Fill">
                                <VisualBrush.Visual>
                                    <Image Source="{Binding Asset.Icon}" Width="{StaticResource AssetIconWidth}" Height="{StaticResource AssetIconWidth}"/>
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Border.Background>
                    </Border>
                    <Border IsHitTestVisible="False" CornerRadius="5" BorderThickness="2">
                        <Border.Background>
                            <ImageBrush ImageSource="/Resources/TextureEditor/Checker64.png"/>
                        </Border.Background>
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Asset}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border>
                            <Border.Background>
                                <VisualBrush Viewport="0.1,0.2,0.8,0.6" Visual="{StaticResource MultivalueTextBlock}"/>
                            </Border.Background>
                        </Border>
                    </Border>
                    <Button Style="{StaticResource RemoveButtonStyle}" Click="OnRemoveInput_Button_Click"
                            x:Name="removeButton" Visibility="Collapsed" Margin="5"/>
                </Grid>
                <TextBlock Text="{Binding Name}" MaxWidth="{StaticResource AssetIconWidth}" Style="{StaticResource LightTextBlockStyle}"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Height="40" HorizontalAlignment="Center" Margin="0,3,0,0"/>
            </StackPanel>
            <DataTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Visibility" TargetName="removeButton" Value="Visible"/>
                </Trigger>
                <DataTrigger Binding="{Binding Ignore}" Value="True">
                    <Setter Property="Visibility" TargetName="removeButton" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="0,10,0,0">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource LightTextBlockStyle}"/>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Background="{StaticResource panelBackground}" Margin="0,0,0,3">
            <TextBlock Text="Applied Material" Foreground="LavenderBlush" Opacity="0.7" DockPanel.Dock="Top" HorizontalAlignment="Left"
                       Margin="5,0,0,5" Typography.Capitals="SmallCaps" FontSize="14"/>
            <TextBlock Text="Name" Width="78" Margin="5,0,0,0"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=Explicit}" HorizontalAlignment="Stretch" Margin="0,5,5,5"
                     GotKeyboardFocus="OnName_TextBox_GotKeyboardFocus"
                     LostKeyboardFocus="OnName_TextBox_LostKeyboardFocus"/>
        </DockPanel>

        <StackPanel Grid.Row="1" Background="{StaticResource panelBackground}">
            <StackPanel.Resources>
                <Style TargetType="{x:Type TextBlock}" x:Key="{x:Type TextBlock}">
                    <Setter Property="Foreground" Value="Moccasin"/>
                    <Setter Property="Opacity" Value="0.6"/>
                </Style>
            </StackPanel.Resources>

            <StackPanel Orientation="Horizontal" Margin="5,0,0,0">
                <Border Style="{StaticResource DropBorderStyle}" Margin="0,5,5,5"
                        Width="{StaticResource AssetIconWidth}" Height="{StaticResource AssetIconWidth}">
                    <Border.Background>
                        <VisualBrush Stretch="Fill">
                            <VisualBrush.Visual>
                                <Image Source="{Binding MaterialInfo.Icon}"/>
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </Border.Background>
                </Border>
                <StackPanel Margin="5">
                    <TextBlock Text="{Binding MaterialInfo.FileName}" d:Text="PBRMaterial"/>
                    <TextBlock Text="{Binding Inputs.Count, StringFormat='Inputs: {0}'}" d:Text="Inputs: 5"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <Expander Grid.Row="2" Margin="0,3" Background="{StaticResource panelBackground}">
            <Expander.Header>
                <TextBlock Text="Surface Constants" Foreground="Lavender" Opacity="0.7"/>
            </Expander.Header>
            <local:MaterialSurfaceView MinWidth="250"/>
        </Expander>

        <ItemsControl ItemsSource="{Binding Inputs}" Grid.Row="3" Margin="0,0,0,2" Background="{StaticResource panelBackground}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Margin="0,10,0,0"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <Border Grid.Row="3" VerticalAlignment="Bottom" Background="{StaticResource Editor.Selected.BackgroundBrush}" Height="2"/>
    </Grid>
</UserControl>
