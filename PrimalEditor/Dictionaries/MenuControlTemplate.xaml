                                    <Rectangle Width="1" Margin="29,2,0,2" HorizontalAlignment="Left" Fill="{StaticResource Editor.Window.GrayBrush4}" />
                                    <Rectangle Width="1" Margin="30,2,0,2" HorizontalAlignment="Left" Fill="{StaticResource Editor.Window.GrayBrush3}" />
