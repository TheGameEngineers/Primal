        <Line X1="0" X2="100" Y1="0" Y2="0" Canvas.Top="20" Canvas.Left="0" Stroke="White" StrokeThickness="0.2"/>
        <Line X1="0" X2="100" Y1="0" Y2="0" Canvas.Top="40" Canvas.Left="0" Stroke="White" StrokeThickness="0.2"/>
        <Line X1="0" X2="100" Y1="0" Y2="0" Canvas.Top="60" Canvas.Left="0" Stroke="White" StrokeThickness="0.2"/>
        <Line X1="0" X2="100" Y1="0" Y2="0" Canvas.Top="80" Canvas.Left="0" Stroke="White" StrokeThickness="0.2"/>

        <Rectangle Fill="Transparent" Stroke="White" StrokeThickness="0.2" Width="100" Height="100"/>
    </Canvas>

    <Style TargetType="{x:Type ctrl:ComponentView}" x:Key="{x:Type ctrl:ComponentView}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctrl:ComponentView}">
                    <Expander IsExpanded="True" x:Name="expander"
                              Background="{StaticResource Editor.Window.GrayBrush3}">
                        <Expander.Style>
                            <Style TargetType="{x:Type Expander}">
                                <Setter Property="Foreground" Value="{StaticResource Editor.FontBrush}"/>
                            </Style>
                        </Expander.Style>
                        <Expander.Header>
                            <TextBlock FontWeight="Bold" Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Expander.Header>
                        <ContentPresenter Margin="5"/>
                    </Expander>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="expander" Property="Background" Value="{StaticResource Editor.Window.GrayBrush4}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type utl:RenderSurfaceControl}" x:Key="{x:Type utl:RenderSurfaceControl}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type utl:RenderSurfaceControl}">
                    <ContentPresenter/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>