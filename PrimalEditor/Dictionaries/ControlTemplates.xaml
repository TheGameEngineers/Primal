        <Line X1="0" X2="100" Y1="0" Y2="0" Canvas.Top="50" Canvas.Left="0" Stroke="White" StrokeThickness="0.1"/>
        <Line X1="0" X2="100" Y1="0" Y2="0" Canvas.Top="70" Canvas.Left="0" Stroke="White" StrokeThickness="0.1"/>
