<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <XamlDebuggingInformation>True</XamlDebuggingInformation>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Configurations>DebugEditor;ReleaseEditor</Configurations>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Resources\Icons\Primal.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.0.1</Version>
    <OutputPath>..\$(Platform)\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>..\$(Platform)\intermediate\$(MSBuildProjectName)\$(Configuration)\</IntermediateOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='DebugEditor|x64'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='ReleaseEditor|x64'">
    <Optimize>True</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="envdte" Version="17.14.40260" />
    <PackageReference Include="envdte80" Version="17.14.40260" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\ContentBrowser\FolderLarge.png" />
    <Resource Include="Resources\ContentBrowser\FolderSmall.png" />
    <Resource Include="Resources\ContentBrowser\ListView.png" />
    <Resource Include="Resources\ContentBrowser\OpenImportCfg.png" />
    <Resource Include="Resources\ContentBrowser\TileView.png" />
    <Resource Include="Resources\MaterialEditor\DefaultMaterialShaders.hlsl" />
    <Resource Include="Resources\PrimitiveMeshView\Checkermap.png" />
    <Resource Include="Resources\PrimitiveMeshView\CubeCheckermap.png" />
    <Resource Include="Resources\PrimitiveMeshView\IcoSphere.png" />
    <Resource Include="Resources\PrimitiveMeshView\PlaneTexture.png" />
    <Resource Include="Resources\RenderSurface\CameraSettings.png" />
    <Resource Include="Resources\TextureEditor\ChannelSelectShader.cso" />
    <Resource Include="Resources\TextureEditor\Checker64.png" />
  </ItemGroup>
  
  <ItemGroup>
    <Content Include="Resources\ProjectTemplates\**" Link=".\Resources\ProjectTemplates\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources\DefaultAssets\**" Link=".\Resources\DefaultAssets\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Engine\EngineAPI\**" Link=".\Include\EngineAPI\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Engine\EditorAPI\**" Link=".\Include\EditorAPI\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Engine\Common\**" Link=".\Include\Common\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Engine\Utilities\**" Link=".\Include\Utilities\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources\Icons\Primal.ico" />
  </ItemGroup>

  <ItemGroup>
    <EngineBuildInput Include="$(SolutionDir)Engine\**\*.cpp;$(SolutionDir)Engine\**\*.h;$(SolutionDir)Engine\Engine.vcxproj" />
    <UpToDateCheckInput Include="$(OutDir)engine.lib;$(OutDir)engined.lib;@(EngineBuildInput)" />
    <UpToDateCheckOutput Include="$(OutDir)Lib\engine.lib;$(OutDir)Lib\engined.lib" />
  </ItemGroup>

  <ItemGroup>
    <EngineBuild Include="$(SolutionDir)Engine\Engine.vcxproj">
      <Properties>SolutionDir=$(SolutionDir);Configuration=Debug;Platform=$(Platform);OutDir=$(OutDir)Lib\;TargetName=Engined</Properties>
    </EngineBuild>
    <EngineBuild Include="$(SolutionDir)Engine\Engine.vcxproj">
      <Properties>SolutionDir=$(SolutionDir);Configuration=Release;Platform=$(Platform);OutDir=$(OutDir)Lib\</Properties>
    </EngineBuild>
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="Build" Inputs="$(OutDir)engine.lib;$(OutDir)engined.lib;@(EngineBuildInput)" Outputs="$(OutDir)Lib\engine.lib;$(OutDir)engined.lib">
    <MSBuild Projects="@(EngineBuild)" BuildInParallel="true" />
  </Target>

   <Target Name="RemoveWpfTempDirectories" AfterTargets="PostBuild">
    <PropertyGroup>
      <WpfTempDirectories>$([System.IO.Directory]::GetDirectories('$(MSBuildProjectDirectory)\..\$(Platform)\intermediate', '*_wpftmp'))</WpfTempDirectories>
    </PropertyGroup>
    <RemoveDir Directories="$(WpfTempDirectories)" />
  </Target>     
</Project>