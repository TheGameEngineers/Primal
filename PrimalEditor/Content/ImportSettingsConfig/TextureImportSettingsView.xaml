<UserControl x:Class="PrimalEditor.Content.TextureImportSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PrimalEditor.Content"
             xmlns:primal="clr-namespace:PrimalEditor"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type={x:Type local:TextureImportSettings}}"
             Background="{StaticResource Editor.Window.GrayBrush3}"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="booleanToVisibilityConverter"/>
        <primal:EnumDescriptionConverter x:Key="enumDescriptionConverter"/>
        <local:TextureDimensionToBooleanConverter x:Key="textureDimensionToBooleanConverter"/>
        
        <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource LightTextBlockStyle}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource Editor.Disabled.FontBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <ObjectDataProvider x:Key="bcFormatEnumDataSource" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="local:BC_FORMAT"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>
    <Grid VerticalAlignment="Top">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition MinHeight="32"/>
            <RowDefinition MinHeight="32"/>
            <RowDefinition MinHeight="32"/>
            <RowDefinition MinHeight="32"/>
            <RowDefinition MinHeight="32"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Dimension"/>
        <WrapPanel VerticalAlignment="Center" Grid.Row="0" Grid.Column="1" Margin="0,5" Orientation="Vertical">
            <WrapPanel.Resources>
                <Style TargetType="{x:Type RadioButton}" BasedOn="{StaticResource {x:Type RadioButton}}">
                    <Setter Property="Margin" Value="0,0,20,0"/>
                    <Setter Property="GroupName" Value="Dimension"/>
                    <Setter Property="Height" Value="28"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                </Style>
            </WrapPanel.Resources>
            <RadioButton IsChecked="{Binding Dimension, Converter={StaticResource textureDimensionToBooleanConverter}, ConverterParameter=0}"
                         Content="1D"/>
            <RadioButton IsChecked="{Binding Dimension, Converter={StaticResource textureDimensionToBooleanConverter}, ConverterParameter=1}"
                         Content="2D" d:IsChecked="True"/>
            <RadioButton IsChecked="{Binding Dimension, Converter={StaticResource textureDimensionToBooleanConverter}, ConverterParameter=2}"
                         Content="3D" d:IsEnabled="False"/>
            <RadioButton IsChecked="{Binding Dimension, Converter={StaticResource textureDimensionToBooleanConverter}, ConverterParameter=3}"
                         Content="Cubemap"/>
            <StackPanel d:Visibility="Visible">
                <StackPanel.Style>
                    <Style TargetType="{x:Type StackPanel}">
                        <Setter Property="IsEnabled" Value="False"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Dimension}" Value="{x:Static local:TextureDimension.TextureCube}">
                                <Setter Property="IsEnabled" Value="True"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <StackPanel Orientation="Horizontal" Height="28">
                    <StackPanel.Style>
                        <Style TargetType="{x:Type StackPanel}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PrefilterCubeMap}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Cubemap Size" Width="100" />
                    <TextBox Text="{Binding CubeMapSize}" Width="96" d:Text="1024"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Height="28">
                    <TextBlock Text="Mirror Cubemap" Width="100"/>
                    <CheckBox IsChecked="{Binding MirrorCubeMap}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Height="28">
                    <TextBlock Text="Prefilter" Width="100"/>
                    <CheckBox IsChecked="{Binding PrefilterCubeMap}"/>
                </StackPanel>
            </StackPanel>
        </WrapPanel>
        
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Mip Levels"/>
        <Slider Style="{StaticResource HorizontalSliderStyle}" Grid.Row="1" Grid.Column="1" IsMoveToPointEnabled="True"
                VerticalAlignment="Center" TickFrequency="1" TickPlacement="BottomRight"
                Minimum="0" Maximum="{Binding Source={x:Static local:Texture.MaxMipLevels}}"
                Value="{Binding MipLevels}" SmallChange="1"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,5,0" Text="Compress"/>
        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
            <CheckBox x:Name="compressCheckBox" VerticalAlignment="Center" IsChecked="{Binding Compress}" d:IsChecked="True"/>
            <StackPanel Orientation="Horizontal">
                <StackPanel.Style>
                    <Style TargetType="{x:Type StackPanel}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Compress}" Value="True"/>
                                    <Condition Binding="{Binding FormatIndex}" Value="0"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Margin="30,0,5,0" Text="Prefer BC7"/>
                <CheckBox VerticalAlignment="Center" IsChecked="{Binding PreferBC7}"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,20,0" Text="Output Format"/>
        <Grid Grid.Row="3" Grid.Column="1">
            <TextBlock Text="{Binding OutputFormat, Converter={StaticResource enumDescriptionConverter}}"/>
            <ComboBox ItemsSource="{Binding Source={StaticResource bcFormatEnumDataSource}, Converter={StaticResource enumDescriptionConverter}}"
                      x:Name="formatComboBox" VerticalAlignment="Center" SelectedIndex="{Binding FormatIndex}"
                      Visibility="{Binding Compress, Converter={StaticResource booleanToVisibilityConverter}}"/>
        </Grid>

        <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,5,0" Text="Alpha Threshold" x:Name="alphaTextBlock" d:Visibility="Visible">
            <TextBlock.Style>
                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource LightTextBlockStyle}">
                    <Setter Property="Visibility" Value="Hidden"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Compress}" Value="True"/>
                                <Condition Binding="{Binding FormatIndex}" Value="1"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <Slider Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding AlphaThreshold}"
                Style="{StaticResource HorizontalSliderStyle}" VerticalAlignment="Center" LargeChange="0.1"
                Visibility="{Binding Path=Visibility, ElementName=alphaTextBlock}"/>
    </Grid>
</UserControl>
